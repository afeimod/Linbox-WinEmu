#!/bin/sh
# linbox-wine: glibc wine 启动脚本
# 
# 工作原理:
#   wine 不在 proot 容器内运行, 而是直接在 Android 上运行
#   此脚本通过 fifo 向 Android 端发送启动命令
#   X11 和音频通过共享的 Termux-X11/PulseAudio 实现
#
# 用法:
#   linbox-wine              # 启动 winefile 文件管理器
#   linbox-wine taskmgr      # 启动任务管理器 (wine 内置程序)
#   linbox-wine notepad      # 启动记事本
#   linbox-wine regedit      # 启动注册表编辑器
#   linbox-wine winecfg      # 启动 wine 配置
#   linbox-wine /path/exe.exe  # 启动指定 exe 文件
#   linbox-wine kill         # 停止 wine

# fifo 路径 (imagefs 通过 --bind 挂载到 /opt/glibc-wine)
FIFO="/opt/glibc-wine/tmp/wine-cmd"

# 检查 fifo 是否存在
if [ ! -p "$FIFO" ]; then
    echo "错误: fifo 不存在 ($FIFO)"
    echo "请确保:"
    echo "  1. glibc wine 服务已启动 (Android 端 GlibcWineCommandServer)"
    echo "  2. imagefs 已通过 --bind 挂载到 /opt/glibc-wine"
    echo ""
    echo "排查:"
    echo "  ls -la /opt/glibc-wine/tmp/wine-cmd"
    echo "  adb logcat | grep GlibcWineCmdServer"
    exit 1
fi

# 发送命令到 fifo
# 使用 printf 避免echo的换行符差异, 确保发送完整一行
case "$1" in
    kill)
        printf "kill\n" > "$FIFO"
        echo "已发送停止命令"
        ;;
    "")
        # 无参数, 启动 winefile
        printf "winefile\n" > "$FIFO"
        echo "命令已发送, winefile 将在桌面显示"
        ;;
    *)
        # 有参数, 启动指定程序
        # 支持 wine 内置程序 (taskmgr, notepad, regedit 等) 和外部 exe
        printf "exe:%s\n" "$*" > "$FIFO"
        echo "命令已发送: $*"
        echo "wine 窗口将在 Termux-X11 桌面显示"
        ;;
esac
