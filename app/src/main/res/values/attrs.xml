<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ImagePickerView styleable attributes -->
    <declare-styleable name="ImagePickerView">
        <attr name="activityTypeCode" format="integer" />
    </declare-styleable>

    <!-- NumberPicker styleable attributes -->
    <declare-styleable name="NumberPicker">
        <attr name="minValue" format="integer" />
        <attr name="maxValue" format="integer" />
        <attr name="step" format="integer" />
        <attr name="value" format="integer" />
    </declare-styleable>
</resources>
